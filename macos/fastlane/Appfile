# app_identifier("[[APP_IDENTIFIER]]") # The bundle identifier of your app
# apple_id("[[APPLE_ID]]") # Your Apple Developer Portal username


# For more information about the Appfile, see:
#     https://docs.fastlane.tools/advanced/#appfile
default_platform(:ios)

platform :ios do
  desc "Run static analysis, unit/widget tests, and a dev-flavor ipa build for PR checks"
  lane :validate_pr do
    flutter_root = File.expand_path("../../",__dir__)
    Dir.chdir(flutter_root) do
      sh("flutter pub get")
      sh("flutter analyze")
      sh("flutter test")
      sh("flutter build ipa --flavor dev -t lib/main_dev.dart --no-codesign")
    end
  end
end